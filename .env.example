APP_NAME=Adaptive Agentic RAG Platform
APP_ENV=local
API_TOKEN=dev-token
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
EMBEDDING_TIMEOUT_SECONDS=30
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=256
QUALITY_MIN_TOTAL_CASES=12
QUALITY_MIN_ROUTE_ACCURACY=0.95
QUALITY_MIN_RAG_HIT_RATE=0.90
QUALITY_MIN_TOOL_ACCURACY=0.95
QUALITY_MAX_AVERAGE_LATENCY_MS=500
RAG_BACKEND=memory
RAG_INDEX_NAME=idx:rag_chunks
RAG_VECTOR_DIMENSIONS=256
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
SQLITE_URL=sqlite:///./data/app.db
