APP_NAME=Adaptive Agentic RAG Platform
APP_ENV=local
API_TOKEN=dev-token
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
EMBEDDING_PROVIDER=hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
EMBEDDING_TIMEOUT_SECONDS=30
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=256
QUALITY_MIN_TOTAL_CASES=12
QUALITY_MIN_ROUTE_ACCURACY=0.95
QUALITY_MIN_RAG_HIT_RATE=0.90
QUALITY_MIN_TOOL_ACCURACY=0.95
QUALITY_MAX_AVERAGE_LATENCY_MS=500
RAG_BACKEND=memory
# For persistent Milvus deployment set RAG_BACKEND=milvus; see docs/milvus.md.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=rag_chunks_v1
MILVUS_TIMEOUT_SECONDS=15
# Change revision AND collection when changing embedding model, even at the same dimension.
MILVUS_EMBEDDING_REVISION=hash-v1
RAG_INDEX_NAME=idx:rag_chunks:v2
RAG_VECTOR_DIMENSIONS=256
RAG_CANDIDATE_MULTIPLIER=4
RAG_RRF_K=60
RAG_BM25_WEIGHT=1.0
RAG_VECTOR_WEIGHT=0.1
RERANK_PROVIDER=none
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_CANDIDATE_COUNT=12
RERANK_TIMEOUT_SECONDS=15
RERANK_FAIL_OPEN=true
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
SQLITE_URL=sqlite:///./data/app.db

# Bounded context and retention (characters, not tokens)
CONTEXT_RECENT_MESSAGES=6
CONTEXT_HISTORY_CHARS=6000
CONTEXT_MESSAGE_CHARS=2000
CONTEXT_SUMMARY_CHARS=1200
SESSION_MAX_MESSAGES=100
SESSION_MAX_CHECKPOINTS=30
MEMORY_MAX_ITEMS=100
MEMORY_TTL_DAYS=180
MEMORY_ITEM_CHARS=320
