      "message": "那需要谁审批",
      "expected_route": "rag",
      "expected_status": "selected",
      "category": "followup",
      "history": [
        {
          "role": "user",
          "content": "公司出差报销需要哪些材料？"
        }
      ]
    },
    {
      "id": "r24",
      "message": "你好",
      "expected_route": "chat",
      "expected_status": "selected",
      "category": "no_replay",
      "history": [
        {
          "role": "user",
          "content": "计算12+30"
